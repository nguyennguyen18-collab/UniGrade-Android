<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Chữ -->
    <style name="Txt"><item name="android:textColor">@color/text</item><item name="android:textSize">13sp</item></style>
    <style name="Txt.Title"><item name="android:textSize">15sp</item><item name="android:textStyle">bold</item></style>
    <style name="Txt.Heading"><item name="android:textSize">18sp</item><item name="android:textStyle">bold</item></style>
    <style name="Txt.Bold"><item name="android:textStyle">bold</item></style>
    <style name="Txt.Muted"><item name="android:textSize">12sp</item><item name="android:textColor">@color/muted</item></style>
    <style name="Txt.Small"><item name="android:textSize">11sp</item><item name="android:textColor">@color/muted</item></style>
    <style name="Txt.Tiny"><item name="android:textSize">10sp</item><item name="android:textColor">@color/faint</item></style>
    <style name="Txt.Label"><item name="android:textSize">12sp</item><item name="android:textColor">@color/muted</item><item name="android:textStyle">bold</item></style>
    <style name="Txt.Section">
        <item name="android:textSize">11sp</item><item name="android:textColor">@color/muted</item><item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item><item name="android:textAllCaps">true</item>
    </style>
    <style name="Txt.Link"><item name="android:textSize">12sp</item><item name="android:textColor">@color/primary</item><item name="android:textStyle">bold</item></style>
    <style name="Txt.Mono"><item name="android:typeface">monospace</item><item name="android:textStyle">bold</item></style>
    <style name="Txt.Value"><item name="android:typeface">monospace</item><item name="android:textStyle">bold</item><item name="android:textSize">26sp</item></style>

    <!-- Thành phần -->
    <style name="Card">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:paddingLeft">16dp</item><item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">14dp</item><item name="android:paddingBottom">14dp</item>
    </style>
    <style name="Chip" parent="Txt.Mono">
        <item name="android:textSize">11sp</item><item name="android:textColor">@color/primary</item>
        <item name="android:background">@drawable/bg_chip</item><item name="android:backgroundTint">@color/primary_soft</item>
        <item name="android:paddingLeft">8dp</item><item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">3dp</item><item name="android:paddingBottom">3dp</item>
    </style>
    <style name="Pill" parent="Txt.Bold">
        <item name="android:textSize">11sp</item><item name="android:textColor">@color/muted</item>
        <item name="android:background">@drawable/bg_pill</item><item name="android:backgroundTint">@color/chip_gray</item>
        <item name="android:paddingLeft">10dp</item><item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">4dp</item><item name="android:paddingBottom">4dp</item>
    </style>
    <style name="Btn" parent="Txt.Bold">
        <item name="android:textSize">15sp</item><item name="android:textColor">@color/white</item><item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_btn_primary</item><item name="android:clickable">true</item>
        <item name="android:paddingLeft">16dp</item><item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">13dp</item><item name="android:paddingBottom">13dp</item>
    </style>
    <style name="BtnOutline" parent="Txt.Bold">
        <item name="android:gravity">center</item><item name="android:background">@drawable/bg_btn_outline</item><item name="android:clickable">true</item>
        <item name="android:paddingLeft">14dp</item><item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">10dp</item><item name="android:paddingBottom">10dp</item>
    </style>
    <style name="Input" parent="Txt">
        <item name="android:textSize">15sp</item><item name="android:textColorHint">@color/faint</item>
        <item name="android:background">@drawable/bg_field</item><item name="android:singleLine">true</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="InputSearch" parent="Input">
        <item name="android:background">@drawable/bg_field_white</item>
        <item name="android:drawableStart">@drawable/ic_search</item>
        <item name="android:drawableTint">@color/faint</item>
        <item name="android:drawablePadding">10dp</item>
    </style>
    <style name="FilterChip" parent="Txt.Bold">
        <item name="android:textColor">@color/chip_text</item><item name="android:background">@drawable/bg_filter_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingLeft">14dp</item><item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">8dp</item><item name="android:paddingBottom">8dp</item>
    </style>
    <style name="SegItem" parent="Txt.Bold">
        <item name="android:textColor">@color/seg_text</item><item name="android:background">@drawable/bg_segment_item</item>
        <item name="android:gravity">center</item><item name="android:clickable">true</item>
        <item name="android:paddingLeft">8dp</item><item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">9dp</item><item name="android:paddingBottom">9dp</item>
    </style>
    <style name="Avatar" parent="Txt.Bold">
        <item name="android:textColor">@color/white</item><item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_avatar</item>
    </style>
    <style name="IconBadge">
        <item name="android:background">@drawable/bg_badge</item><item name="android:padding">9dp</item>
    </style>
    <style name="Divider"><item name="android:background">@color/border</item></style>
</resources>
