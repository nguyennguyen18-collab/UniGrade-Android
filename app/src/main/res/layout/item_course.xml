<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/c_code" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/c_class" style="@style/Txt.Small" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView android:id="@+id/c_credits" style="@style/Pill" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView android:id="@+id/c_name" style="@style/Txt.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:textSize="17sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_box_soft12" android:orientation="vertical"
        android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="10dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="3dp" android:paddingBottom="3dp">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginRight="8dp" android:src="@drawable/ic_clock" android:tint="@color/primary"/>
            <TextView android:id="@+id/c_schedule" style="@style/Txt.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="3dp" android:paddingBottom="3dp">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginRight="8dp" android:src="@drawable/ic_place" android:tint="@color/primary"/>
            <TextView android:id="@+id/c_room" style="@style/Txt.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/c_avatar" style="@style/Avatar" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginRight="10dp" android:textSize="11sp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/c_lecturer" style="@style/Txt.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/c_email" style="@style/Txt.Small" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <ImageView android:id="@+id/c_mail" android:layout_width="40dp" android:layout_height="40dp" android:clickable="true" android:padding="9dp" android:src="@drawable/ic_mail" android:tint="@color/primary"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView style="@style/Txt.Muted" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/item_course_tien_do_chuyen_can"/>
        <TextView android:id="@+id/c_attend" style="@style/Txt.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp"/>
    </LinearLayout>
    <ProgressBar android:id="@+id/c_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp"
        android:indeterminate="false" android:max="100" android:minHeight="8dp" android:maxHeight="8dp" android:progressDrawable="@drawable/bg_progress"/>
    <TextView android:id="@+id/c_syllabus" style="@style/Txt.Link" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:gravity="center" android:paddingTop="12dp" android:text="@string/item_course_xem_de_cuong_mon_hoc"/>
</LinearLayout>
