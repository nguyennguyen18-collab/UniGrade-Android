<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/h_name" style="@style/Txt.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp"/>
        <TextView android:id="@+id/h_code" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView android:id="@+id/h_sem" style="@style/Txt.Mono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/faint" android:textSize="10sp" android:textStyle="normal"/>
    </LinearLayout>
    <TextView android:id="@+id/h_subject" style="@style/Txt.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_box_soft12" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="10dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/Txt.Tiny" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/item_history_diem_ban_dau"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/h_old" style="@style/Txt.Mono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="17sp"/>
                <TextView android:id="@+id/h_old_letter" style="@style/Txt.Small" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_arrow" android:tint="@color/primary"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/Txt.Tiny" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="@string/item_history_diem_dieu_chinh" android:textColor="@color/primary"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/h_new" style="@style/Txt.Mono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/primary" android:textSize="17sp"/>
                <TextView android:id="@+id/h_new_letter" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/h_reason" style="@style/Txt.Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_soft_blue"
        android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:textStyle="italic"/>
    <View style="@style/Divider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginRight="6dp" android:src="@drawable/ic_person" android:tint="@color/muted"/>
        <TextView android:id="@+id/h_by" style="@style/Txt.Small" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginRight="4dp" android:src="@drawable/ic_clock" android:tint="@color/muted"/>
        <TextView android:id="@+id/h_time" style="@style/Txt.Mono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="normal"/>
    </LinearLayout>
</LinearLayout>
