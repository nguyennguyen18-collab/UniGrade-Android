<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
    android:orientation="horizontal" android:clickable="true" android:background="@drawable/bg_row_ripple"
    android:paddingTop="10dp" android:paddingBottom="10dp">
    <ImageView android:id="@+id/a_icon" style="@style/IconBadge" android:layout_width="36dp" android:layout_height="36dp"
        android:layout_marginRight="12dp" android:backgroundTint="@color/chip_gray" android:tint="@color/muted"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/a_title" style="@style/Txt.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp"/>
        <TextView android:id="@+id/a_sub" style="@style/Txt.Small" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:tint="@color/faint"/>
</LinearLayout>
