<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pc_root" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="8dp"
    android:background="@drawable/bg_pick_chip" android:clickable="true" android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingLeft="10dp" android:paddingRight="14dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/pc_avatar" style="@style/Avatar" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginRight="8dp" android:textSize="10sp"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/pc_name" style="@style/Txt.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/chip_text" android:textSize="12sp"/>
        <TextView android:id="@+id/pc_code" style="@style/Txt.Mono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/pick_code" android:textSize="10sp" android:textStyle="normal"/>
    </LinearLayout>
</LinearLayout>
