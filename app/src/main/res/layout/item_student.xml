<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/s_root" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:clickable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/s_avatar" style="@style/Avatar" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginRight="12dp" android:textSize="15sp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/s_name" style="@style/Txt.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/s_code" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/s_class" style="@style/Txt.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/Txt.Tiny" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="@string/item_student_gpa_he_4" android:textStyle="bold" android:textSize="9sp"/>
            <TextView android:id="@+id/s_gpa" style="@style/Txt.Mono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:textSize="18sp"/>
        </LinearLayout>
    </LinearLayout>
    <View style="@style/Divider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:layout_marginBottom="4dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/s_major" style="@style/Txt.Muted" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <ImageView android:id="@+id/s_edit" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginRight="4dp" android:clickable="true" android:padding="8dp" android:src="@drawable/ic_edit" android:tint="@color/muted"/>
        <ImageView android:id="@+id/s_delete" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginRight="4dp" android:clickable="true" android:padding="8dp" android:src="@drawable/ic_delete" android:tint="@color/muted"/>
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:tint="@color/faint"/>
    </LinearLayout>
</LinearLayout>
