<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <View style="@style/Divider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/rg_code" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:backgroundTint="@color/chip_gray" android:textColor="@color/muted"/>
                <TextView android:id="@+id/rg_credits" style="@style/Txt.Small" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp"/>
            </LinearLayout>
            <TextView android:id="@+id/rg_name" style="@style/Txt.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp"/>
            <TextView android:id="@+id/rg_sem" style="@style/Txt.Small" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/rg_total" style="@style/Txt.Mono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:textSize="20sp"/>
            <TextView android:id="@+id/rg_letter" style="@style/Txt.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
